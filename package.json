{
  "name": "memora",
  "version": "0.0.1",
  "private": true,
  "description": "念册 · Memora — 智能相册与主题成册",
  "scripts": {
    "build": "pnpm -r run build",
    "dev:web": "pnpm --filter @memora/web dev",
    "dev:api": "pnpm --filter @memora/api dev",
    "dev:worker": "pnpm --filter @memora/worker dev",
    "postinstall": "pnpm --filter @memora/shared build && pnpm --filter @memora/storage build",
    "pretypecheck": "pnpm --filter @memora/shared build && pnpm --filter @memora/storage build",
    "pretest": "pnpm --filter @memora/shared build && pnpm --filter @memora/storage build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --if-present run test",
    "check:contracts": "node scripts/check-contracts.mjs",
    "verify:upload": "node scripts/verify-upload.mjs",
    "smoke": "node scripts/smoke-share.mjs",
    "lint": "pnpm -r run lint --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
