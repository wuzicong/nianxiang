{
  "name": "memora",
  "version": "0.0.1",
  "private": true,
  "description": "念册 · Memora — 智能相册与主题成册",
  "scripts": {
    "build": "pnpm -r run build",
    "dev:web": "pnpm --filter @memora/web dev",
    "dev:api": "pnpm --filter @memora/api dev",
    "dev:worker": "pnpm --filter @memora/worker dev",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
