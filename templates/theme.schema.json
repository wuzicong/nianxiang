{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nianxiang.local/schemas/theme.json",
  "title": "Memora album theme",
  "type": "object",
  "required": ["id", "name", "version", "tokens", "layouts", "slots"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["zh", "en"],
          "properties": {
            "zh": { "type": "string" },
            "en": { "type": "string" }
          }
        }
      ]
    },
    "track": { "type": "string" },
    "moodDefault": { "type": "string" },
    "version": { "type": "string" },
    "tokens": { "type": "object" },
    "layouts": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "slots": { "type": "array", "minItems": 1 },
    "fillRules": { "type": "object" },
    "matchHints": { "type": "object" },
    "decorations": { "type": "array", "items": { "type": "string" } },
    "shareCopyDefaults": { "type": "object" }
  },
  "additionalProperties": true
}
