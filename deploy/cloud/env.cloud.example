# 云托管示例 — 复制到部署密钥库，勿提交
# 这里没有真实口令。不要把填好的副本提交回仓库。

DEPLOY_MODE=cloud
MEMORA_ENV=prod
STORAGE_BACKEND=s3

# 会话 Cookie memora_session 是 HttpOnly。云上必须 true。
# 明文 HTTP 不会保存这枚 Cookie。不要为了排障改回 false。
COOKIE_SECURE=true

# 托管库用 verify-full 校验 CA。只加密不校验时才退回 sslmode=require。
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/memora?sslmode=require
# Redis 必须走 TLS。口令是 AUTH token，不是示例里的 TOKEN。
REDIS_URL=rediss://:TOKEN@HOST:6379

# 私有桶。Block Public Access 四项全开，禁止匿名 list/get，不要设 public-read。
# AWS 用虚拟主机风格，S3_FORCE_PATH_STYLE=false。终端节点用 https，不要把口令写进 URL。
S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
S3_REGION=ap-southeast-1
S3_BUCKET=memora-prod
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# SSE-KMS（可配；生产建议开启。此处只是占位，不要填真实 ARN 后提交）
AWS_KMS_KEY_ID=

# 预签名只签单个对象。API 会把 TTL 夹在 5–15 分钟。不要调到几小时。
PRESIGN_TTL_MINUTES=10

# 浏览器来源。多个用逗号隔开，不要写 *。
WEB_ORIGINS=https://photos.example.com

# CDN 只缓存衍生图前缀，不缓存原图。
CDN_BASE_URL=https://cdn.example.com/memora-prod

# 分享密码默认可选。设为 true 后，新建分享必须带密码。不要把真实分享密码写在这里。
# SHARE_REQUIRE_PASSWORD=false

# 云上线前可以关掉公开注册。
# AUTH_REGISTRATION=closed
# SESSION_TTL_HOURS=336

# OIDC 尚未实现。不要把真实 client secret 写进任何会提交的文件。
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
