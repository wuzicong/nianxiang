# 云托管示例 — 复制到部署密钥库，勿提交
DEPLOY_MODE=cloud
MEMORA_ENV=prod
STORAGE_BACKEND=s3

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/memora?sslmode=require
REDIS_URL=rediss://:TOKEN@HOST:6379

S3_ENDPOINT=
S3_REGION=ap-southeast-1
S3_BUCKET=memora-prod
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# SSE-KMS（建议生产启用）
AWS_KMS_KEY_ID=arn:aws:kms:region:account:key/xxx

PRESIGN_TTL_MINUTES=10

# CDN 仅衍生图前缀（示例）
CDN_BASE_URL=https://cdn.example.com/memora-prod
