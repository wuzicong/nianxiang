# 复制到仓库外再改，例如 /etc/memora/monitor.env，然后 chmod 600。
# 不要把填过的副本提交进 git，也不要把数据库或 MinIO 口令写进这个文件。
# MEMORA_ALERT_ENABLE=0 时脚本只打印，不外发。

MEMORA_ALERT_ENABLE=0
MEMORA_ALERT_WEBHOOK=https://hooks.example.com/memora
MEMORA_ALERT_EMAIL=ops@example.com

# 公网探测。没有域名时用 http://127.0.0.1。有域名用 https://photos.example.com
MEMORA_CHECK_BASE=http://127.0.0.1

# 与 backup.sh 的 BACKUP_DIR 相同。脚本只看 manifest 的文件名和时间，不读正文。
MEMORA_BACKUP_DIR=/var/backups/memora
MEMORA_BACKUP_MAX_AGE_HOURS=26

MEMORA_DISK_PATH=/
MEMORA_DISK_PERCENT=85

MEMORA_STATE_DIR=/var/lib/memora-monitor
MEMORA_HTTP_FAILS=3
MEMORA_UNLOCK_429_ALERT=30
MEMORA_AUTH_429_ALERT=20
MEMORA_ALERT_REPEAT_SECONDS=21600

# Caddy 容器内的进程日志。计数来自 rate limit exceeded 的 zone，不解析路径。
MEMORA_CADDY_SYSTEM_LOG=/var/log/caddy/memora-system.log

# 可选。生产 Compose 若靠仓库外的 env 做变量替换，把路径写在这里。
# 脚本不读取、不打印那个文件。
# COMPOSE_ENV_FILES=/etc/memora/prod.env
# COMPOSE_FILE=/opt/memora/compose.prod.yml
