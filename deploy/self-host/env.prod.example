# 念册 · Memora — 自托管生产环境（复制为仓库根目录的 .env，勿提交）
# Compose 只用这里的值做 ${} 替换，不会把整份文件灌进容器。
# 开发用的 .env.example 指向 127.0.0.1，不能拿来当生产网络地址。

DEPLOY_MODE=selfhost
MEMORA_ENV=prod
STORAGE_BACKEND=minio

# 换掉。不要用 memora-dev-change-me。口令建议避开空格；含 @ 也可以，入口会编码。
POSTGRES_USER=memora
POSTGRES_PASSWORD=
POSTGRES_DB=memora

MINIO_ROOT_USER=memora
MINIO_ROOT_PASSWORD=

# 默认同 MINIO 根账号。要分开写就两行都填，并且和 MinIO 一致。
# S3_ACCESS_KEY_ID=memora
# S3_SECRET_ACCESS_KEY=

# 必须等于 memora-${MEMORA_ENV}
S3_BUCKET=memora-prod
S3_REGION=us-east-1

# 公网域名。DNS 指到这台机器。留空则 Caddy 只听 80，仅供本机看一眼。
MEMORA_DOMAIN=photos.example.com
# 浏览器来源。多个用逗号隔开，不要写 *。
WEB_ORIGINS=https://photos.example.com

# 会话 Cookie memora_session 是 HttpOnly。公网 HTTPS 必须为 true。
COOKIE_SECURE=true

# 证书通知邮箱不会自动读取。需要的话，在 deploy/self-host/proxy/Caddyfile 的全局块加：
#   email you@example.com

# 可选。closed 后拒绝新注册。
# AUTH_REGISTRATION=open
# SHARE_REQUIRE_PASSWORD=false
# 这一项在构建 web 镜像时写进页面。改了要重新构建，不能只重启。
# NEXT_PUBLIC_SHARE_REQUIRE_PASSWORD=false
# PRESIGN_TTL_MINUTES=10
# SESSION_TTL_HOURS=336
