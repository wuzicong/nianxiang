# 生产站点。打码和限流片段由 Compose 挂到 /etc/caddy/snippets。
# MEMORA_DOMAIN 未设置时 Compose 传入 :80，只听 HTTP。
# 设成域名后 Caddy 申请证书，80 跳到 HTTPS。
# 登录口令在 JSON 正文里。访问日志不记正文。

import /etc/caddy/snippets/Caddyfile
import /etc/caddy/snippets/Caddyfile.ratelimit

{$MEMORA_DOMAIN} {
	import memora_access_log
	import memora_share_limits
	import memora_rate_limited

	handle /health {
		reverse_proxy api:3001
	}

	handle /ready {
		respond "ok" 200
	}

	handle {
		reverse_proxy web:3000
	}
}
