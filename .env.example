# 念册 · Memora — 环境变量模板（复制为 .env，勿提交真实口令）
# 下面是本机开发占位值，与 docker-compose.yml 默认值一致。生产必须换掉。
#
# 自托管最短路径：DEPLOY_MODE=selfhost  STORAGE_BACKEND=minio
# 云托管最短路径：DEPLOY_MODE=cloud     STORAGE_BACKEND=s3
#   云模式把 DATABASE_URL / REDIS_URL / S3_* / AWS_KMS_KEY_ID 放到密钥库，
#   不要启动本 Compose 里的 Postgres / MinIO 当生产存储。
#   自托管也可以把 STORAGE_BACKEND 改成 s3，只绑定你自己的云桶。

DEPLOY_MODE=selfhost
MEMORA_ENV=local
STORAGE_BACKEND=minio

# --- API / Worker ---
API_PORT=3001
# 口令必须与 POSTGRES_PASSWORD 相同
DATABASE_URL=postgresql://memora:memora-dev-change-me@127.0.0.1:5432/memora
REDIS_URL=redis://127.0.0.1:6379

# --- Postgres（Compose）---
POSTGRES_USER=memora
POSTGRES_PASSWORD=memora-dev-change-me
POSTGRES_DB=memora

# --- MinIO（自托管 / 开发）---
# S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY 必须与下面两项相同
MINIO_ROOT_USER=memora
MINIO_ROOT_PASSWORD=memora-dev-change-me
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
# 必须等于 memora-${MEMORA_ENV}
S3_BUCKET=memora-local
S3_ACCESS_KEY_ID=memora
S3_SECRET_ACCESS_KEY=memora-dev-change-me
S3_FORCE_PATH_STYLE=true

# --- 云托管时改为（值放密钥库，不要写进 git）---
# DEPLOY_MODE=cloud
# MEMORA_ENV=prod
# STORAGE_BACKEND=s3
# S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
# S3_FORCE_PATH_STYLE=false
# S3_BUCKET=memora-prod
# AWS_KMS_KEY_ID=
# CDN_BASE_URL=https://cdn.example.com/memora-prod

# 预签名有效期（分钟）。API 会夹紧到 5–15，非法值回落 10
PRESIGN_TTL_MINUTES=10

# 单张原图上限（字节）。非法值回落 25 MiB，并且不能超过 50 MiB
# MAX_UPLOAD_BYTES=26214400

# 会话。默认 14 天。云模式 / staging / prod 的 Cookie 会加 Secure。
# SESSION_TTL_HOURS=336
# 浏览器登录页允许的来源，逗号分隔。不要写 *。
# WEB_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# AUTH_REGISTRATION=open
# COOKIE_SECURE=false
# Web 进程把 /api/v1 转到 API。Next 读 apps/web 下的 env；不设则用这个默认值。
# API_ORIGIN=http://127.0.0.1:3001

# OIDC 挂点。本阶段不读取 client secret，也不走授权码。留空即可，不要填真实密钥。
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# ML 服务（Compose 默认 http://127.0.0.1:8000）
ML_SERVICE_URL=http://127.0.0.1:8000
