# 念册 · Memora — 环境变量模板（复制为 .env，勿提交）
# 双模式：DEPLOY_MODE=selfhost | cloud

DEPLOY_MODE=selfhost
MEMORA_ENV=local
STORAGE_BACKEND=minio

# --- API / Worker ---
API_PORT=3001
DATABASE_URL=postgresql://memora:memora@127.0.0.1:5432/memora
REDIS_URL=redis://127.0.0.1:6379

# --- Postgres（Compose）---
POSTGRES_USER=memora
POSTGRES_PASSWORD=memora-dev-change-me
POSTGRES_DB=memora

# --- MinIO（自托管 / 开发）---
MINIO_ROOT_USER=memora
MINIO_ROOT_PASSWORD=memora-dev-change-me
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=memora-local
S3_ACCESS_KEY_ID=memora
S3_SECRET_ACCESS_KEY=memora-dev-change-me
S3_FORCE_PATH_STYLE=true

# --- 云托管（DEPLOY_MODE=cloud 时覆盖上方 S3 / DATABASE）---
# STORAGE_BACKEND=s3
# AWS_KMS_KEY_ID=
# CDN_BASE_URL=

# 预签名 URL 有效期（分钟），云模式强制 5–15
PRESIGN_TTL_MINUTES=10

# ML 服务（Compose 默认 http://127.0.0.1:8000）
ML_SERVICE_URL=http://127.0.0.1:8000
